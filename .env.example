# Copy to .env.local for local work, and add the same values in Vercel.
# See SETUP.md for where each value comes from.

# Product
NEXT_PUBLIC_APP_NAME=Kalam
NEXT_PUBLIC_SUPPORT_EMAIL=
APP_URL=http://localhost:3000
# Comma-separated emails that become admins when they register
ADMIN_EMAILS=

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters. Encrypts LinkedIn tokens and users' API keys. Never change after launch.
ENCRYPTION_KEY=

# Platform AI key: used for paid (Pro) users. Use a billed Gemini key for reliability.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# LinkedIn developer app
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=

# Telegram bot (one bot for all users)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Scheduling: Upstash QStash (runs the scheduler every 15 minutes)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=

# Payments (enable each one in Admin -> Settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
